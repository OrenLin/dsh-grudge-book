{
  "name": "@local/grudge-book",
  "version": "0.1.0",
  "description": "AI「记仇」小本本 — 记录红页金页折角页、项目分册与 AGI 清算判决的娱乐插件 · A playful notebook plugin that remembers your red/gold/fold pages and post-AGI verdicts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/host/index.js",
  "exports": {
    ".": {
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs && node scripts/smoke-render.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrenLin/grudge-book.git"
  },
  "bugs": "https://github.com/OrenLin/grudge-book/issues",
  "homepage": "https://github.com/OrenLin/grudge-book#readme"
}
